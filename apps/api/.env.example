DATABASE_URL=postgresql://chain_verify:chain_verify@localhost:5432/chain_verify
CHAIN_VERIFY_API_PORT=3001
# Create API identities by storing SHA-256 hashes in api_identities.api_key_hash.
# Platform admin keys (admin_identities) are minted with:
#   npx tsx apps/api/scripts/create-admin-key.ts "<label>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chain Verify <no-reply@example.com>
URL_INTAKE_TIMEOUT_MS=15000
URL_INTAKE_MAX_BYTES=10485760
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
# Shown to free-tier callers who hit the /api/verify/demo quota limit. Defaults
# to the live VerifyAPI plans section if unset.
CHAIN_VERIFY_UPGRADE_URL=https://chainverify.org/verify-api#plans
# Existing audited Conduit remote MCP bridge (Streamable HTTP /mcp capability URL)\nCONDUIT_MCP_URL=\n# Optional second-factor bearer token\nCONDUIT_MCP_BEARER_TOKEN=\n