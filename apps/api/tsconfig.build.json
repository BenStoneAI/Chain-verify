{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "paths": {
      "@chain-verify/proof-core": [
        "../../packages/proof-core/src"
      ],
      "@chain-verify/proof-core/*": [
        "../../packages/proof-core/src/*"
      ],
      "@chain-verify/config": [
        "../../packages/config/src"
      ]
    },
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
